DATABASE_URL=postgres://root:root@localhost:5432/dev_db

# How many jobs one worker process runs at the same time.
WORKER_CONCURRENCY=4
# How many jobs are claimed from the database per round.
WORKER_BATCH_SIZE=10
# A claimed job is considered lost if it is not finished within this window.
WORKER_LEASE_SECONDS=60
# Safety net in case a NOTIFY is missed.
WORKER_POLL_INTERVAL_SECONDS=5
# Retry delay is BACKOFF_BASE^attempts, capped at BACKOFF_MAX.
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_BACKOFF_MAX_SECONDS=300
