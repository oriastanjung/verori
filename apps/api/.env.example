DATABASE_URL=postgres://root:root@localhost:5432/dev_db
HOST=0.0.0.0
PORT=3001

# Must be at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-secret-change-me-at-least-32-chars
WEB_ORIGIN=http://localhost:3000

# Requests per address per second, and how far a caller may burst above it.
# This protects the database from one noisy client. It is not DDoS protection.
# Note: every call the web app makes arrives from one address, so the whole
# front end shares a single bucket. Raise these if you put more traffic through it.
RATE_LIMIT_PER_SECOND=50
RATE_LIMIT_BURST=120
BODY_LIMIT_KB=256
REQUEST_TIMEOUT_SECONDS=20
# Switch on only when the service is served over TLS.
ENABLE_HSTS=false
